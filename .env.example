# Local SQLite storage directory. Docker Compose sets this to /data.
GEXLAB_DATA_DIR=./data

# Maximum retained raw option sessions.
GEXLAB_RAW_SESSIONS=20

# Leave off unless intentionally reproducing calibration work.
GEXLAB_CALIBRATE=0

# Symbols followed by the daily estimates collector.
GEXLAB_ESTIMATE_TICKERS=NVDA,MSFT,AAPL,AMZN,META,GOOGL,TSLA

# Base URL used by the one-pass collection scripts.
GEXLAB_BASE_URL=http://localhost:3000

# Optional SEC operator contact. Set a real email locally or in deployment;
# SEC-backed panels may be unavailable until it is configured.
GEXLAB_SEC_CONTACT=

# Local port for Docker Compose.
GEXLAB_PORT=3000
